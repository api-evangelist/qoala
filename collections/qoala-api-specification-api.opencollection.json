{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qoala API Specification API",
    "version": "v1.3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Specification",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-staging.qoala.app/api/v2/quotation/quotes",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "This API is used by partner to create policy"
        },
        {
          "info": {
            "name": "Get Policy Detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-staging.qoala.app/api/v2/quotation/quotes/partner/status",
            "params": [
              {
                "name": "partner_transaction_number",
                "value": "",
                "type": "query",
                "description": "The Transaction ID serves as a unique identifier for each transaction initiated through the API. Partners are responsible for generating this ID and ensuring its uniqueness across all of their transactions."
              },
              {
                "name": "product_code",
                "value": "",
                "type": "query",
                "description": "Defined by Qoala, this field plays a pivotal role in the API, providing contextual information about certain aspects of the product. However, the details for this field will be shared at a later stage, when the product is ready for testing in the staging environment."
              },
              {
                "name": "quotation_number",
                "value": "",
                "type": "query",
                "description": "Unique identity number generated by qoala system as transaction identifier for each transaction that received by qoala."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Policy detail"
        },
        {
          "info": {
            "name": "Cancel Policy",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api-staging.qoala.app/api/v2/policies/partner/cancel",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Policy cancellation"
        },
        {
          "info": {
            "name": "Create Claim",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-staging.qoala.app/api/v2/claims/partner/create",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Partners could use this endpoint to generate and create a new claim. Qoala will validate and make sure the policy is claimable. Qoala will share the claim number in the response and if needed could also notify the partner via callback Integration.\n### List of Claim Status\n\n| Status Code                | Claim Status (Subject)          | Description                                     |\n| --------------------------- | ------------------------------- | ---------------------------------------------"
        },
        {
          "info": {
            "name": "Cancel Claim",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api-staging.qoala.app/api/v2/claims/partner/cancel",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Claim cancellation"
        },
        {
          "info": {
            "name": "Upload claim documents",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-staging.qoala.app/api/v2/claims/partner/update/presign",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Presign url to upload document"
        },
        {
          "info": {
            "name": "Update claim documents",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api-staging.qoala.app/api/v2/claims/partner/update/presign",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Presign url to upload document"
        },
        {
          "info": {
            "name": "Get Claim Pool",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-staging.qoala.app/api/v2/products/finance/partner/products/stoploss/:claim_pool_code",
            "params": [
              {
                "name": "claim_pool_code",
                "value": "",
                "type": "path",
                "description": "Claim Pool code generated by Qoala"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "this endpoint can be used by the partner to get the claim pool balance"
        },
        {
          "info": {
            "name": "Get Claim Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-staging.qoala.app/api/v2/claims/partner/status",
            "params": [
              {
                "name": "policy_number",
                "value": "",
                "type": "query",
                "description": "Unique identifier for policy generated by qoala system. Policy number is optinal parameter only if claim number is provided in the URL."
              },
              {
                "name": "claim_number",
                "value": "",
                "type": "query",
                "description": "Unique identifier for claim created by qoala system. Claim number is optional parameter only if policy number is provided in the URL"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get claim status"
        },
        {
          "info": {
            "name": "Activate Policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-staging.qoala.app/api/v2/policies/documents/activation",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "API policy activation is needed when the object to be insured needs to be verified. For example, this usually applies to used, second-hand gadgets, but is not needed for new gadgets.  Only policies with a status of non POLICY_ACTIVE can be activated.."
        }
      ]
    }
  ],
  "bundled": true
}